// Title: Resource groups with location and tag count
// Purpose: Which resource groups carry tags and which are naked (tag inheritance policies start here).
// Source table(s): Azure Resource Graph, resourcecontainers
// Parameters to edit: none.
// Notes/traps: resource groups are in resourcecontainers, not resources. A tagged resource group does not
//          mean its resources inherit the tags, that needs a Modify policy.
resourcecontainers
| where type =~ 'microsoft.resources/subscriptions/resourcegroups'
| project subscriptionId, name, location, tagCount = array_length(bag_keys(tags)), tags
| order by subscriptionId asc, name asc
