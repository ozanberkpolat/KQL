// Title: "Update <software>" recommendations per VM with severity, package type, scanner and CVEs
// Purpose: For each unhealthy update recommendation, which VMs are affected and which scanner found it.
// Source table(s): Azure Resource Graph, securityresources (microsoft.security/assessments)
// Parameters to edit: ExactName (one recommendation, e.g. 'Update openssl'; empty = all "Update ..." ones).
// Notes/traps: additionalData field names are inconsistent between scanners: SoftwareName / SoftwareVendor
//          in most rows, lower-case software / vendor in some. Both are coalesced. CvesDetails is a JSON
//          string, DetectedSoftwareVersions is present only on some recommendations.
let ExactName = '';
securityresources
| where type =~ 'microsoft.security/assessments'
| extend displayName = tostring(properties.displayName), state = tostring(properties.status.code)
| where state == 'Unhealthy' and displayName startswith 'Update'
| where ExactName == '' or displayName == ExactName
| extend ad = properties.additionalData
| project displayName,
    vm = tostring(split(id, '/')[8]),
    resourceGroup = tostring(split(id, '/')[4]),
    severity = tostring(properties.metadata.severity),
    packageType = tostring(ad.PackageType),
    software = coalesce(tostring(ad.SoftwareName), tostring(ad.software)),
    vendor = coalesce(tostring(ad.SoftwareVendor), tostring(ad.vendor)),
    detectedVersions = tostring(ad.DetectedSoftwareVersions),
    scanners = tostring(ad.ScannersDetails),
    cves = tostring(ad.CvesDetails)
| order by displayName asc, vm asc
