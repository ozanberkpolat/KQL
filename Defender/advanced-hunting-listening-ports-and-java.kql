// --- Query 2: Java / Tomcat processes (run separately)
// DeviceProcessEvents
// | where DeviceName startswith "srv-app"
// | where FileName in~ ("java.exe", "javaw.exe", "tomcat9.exe", "tomcat9w.exe")
// | summarize LastSeen = max(Timestamp), Count = count() by DeviceName, FileName, FolderPath, ProcessCommandLine
// | order by DeviceName asc
